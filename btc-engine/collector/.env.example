# Persistent collector
PORT=3000
LOG_LEVEL=info
STATE_INTERVAL_MS=1000
REST_POLL_MS=5000
SUPABASE_INTERVAL_MS=60000
MAX_BUFFER=100000

# Redis live-state cache
REDIS_URL=redis://default:password@host:6379

# ClickHouse tick/order-book history
CLICKHOUSE_URL=https://your-clickhouse-host:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=btc

# Dedicated BTC Supabase project (service-role key must stay server-side only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# CoinGlass is stored in Supabase Vault. Do not commit it here.
